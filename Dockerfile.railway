# ============================================================================
# EduPath — Railway production image (Nginx + PHP-FPM in one container)
#
# Railway exposes a single PORT per service, so the web service runs BOTH
# Nginx and PHP-FPM inside this one container. Nginx listens on the
# Railway-provided $PORT and proxies PHP requests to php-fpm on
# 127.0.0.1:9000 (same container, no Docker network hostname).
#
# The same image is reused by the Railway queue-worker service, whose Start
# Command overrides CMD with:  php artisan queue:work database --tries=3
# The entrypoint (docker/railway-entrypoint.sh) is shared and just does
# environment-aware setup then `exec "$@"` — it never starts Nginx/PHP-FPM
# itself, so the worker only ever runs the queue worker command.
# ============================================================================

# ----------------------------------------------------------------------------
# Stage 1 — PHP dependencies (Composer)
# ----------------------------------------------------------------------------
FROM composer:2 AS vendor

WORKDIR /app

# Leverage layer caching: install dependencies using only the manifests first.
COPY composer.json composer.lock ./

# --no-scripts: defer post-autoload-dump (package discovery) until the full
#               application is present so artisan can actually run.
# --no-autoloader + later full install: keep the first pass minimal & cached.
RUN composer install \
        --no-dev \
        --no-interaction \
        --prefer-dist \
        --optimize-autoloader \
        --no-scripts \
        --no-autoloader

# Copy the entire application source into the build stage.
COPY . .

# Re-run now that the application is present. Scripts are executed (the
# post-autoload-dump hook runs `php artisan package:discover`), regenerating
# bootstrap/cache/packages.php + services.php deterministically *inside* the
# image instead of inheriting any host-local state.
RUN composer install \
        --no-dev \
        --no-interaction \
        --prefer-dist \
        --optimize-autoloader

# ----------------------------------------------------------------------------
# Stage 2 — Frontend assets (Node / Vite / Tailwind)
# ----------------------------------------------------------------------------
FROM node:22-alpine AS frontend

WORKDIR /app

# Copy manifests first for good layer caching.
COPY package.json package-lock.json ./
RUN npm ci

# Copy the whole application (respecting .dockerignore). The Blade views under
# resources/views are scanned by Tailwind v3 to generate the CSS utility
# classes — they must be present during `npm run build`.
COPY . .

RUN npm run build

# ----------------------------------------------------------------------------
# Stage 3 — Runtime (PHP-FPM + Nginx)
# ----------------------------------------------------------------------------
FROM php:8.4-fpm AS runtime

# System dependencies required by the PHP extensions and the app itself, plus:
#   nginx        — web server (serves the Laravel public/ directory)
#   gettext-base — provides `envsubst`, used to render $PORT into the vhost
RUN apt-get update && apt-get install -y --no-install-recommends \
        nginx \
        gettext-base \
        git \
        curl \
        libpng-dev \
        libonig-dev \
        libxml2-dev \
        libicu-dev \
        zip \
        unzip \
        libzip-dev \
        procps \
        ca-certificates \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# PHP extensions required by EduPath (matches the existing Dockerfile).
RUN docker-php-ext-install \
        pdo_mysql \
        mbstring \
        exif \
        pcntl \
        bcmath \
        gd \
        zip \
        intl

# OPcache for production performance.
RUN docker-php-ext-install opcache

# Production-oriented PHP settings (matches the existing Dockerfile).
RUN { \
        echo 'opcache.enable=1'; \
        echo 'opcache.memory_consumption=128'; \
        echo 'opcache.interned_strings_buffer=8'; \
        echo 'opcache.max_accelerated_files=10000'; \
        echo 'opcache.validate_timestamps=0'; \
        echo 'opcache.revalidate_freq=0'; \
        echo 'expose_php=0'; \
        echo 'upload_max_filesize=20M'; \
        echo 'post_max_size=25M'; \
        echo 'memory_limit=256M'; \
    } > /usr/local/etc/php/conf.d/edupath.ini

# Remove the Debian Nginx default site so it cannot shadow the Railway vhost
# (the Debian package ships a `listen 80 default_server` in sites-enabled/).
RUN rm -rf /etc/nginx/sites-enabled/default

WORKDIR /var/www/html

# Bake the full application (vendor/ included) into the image.
COPY --from=vendor /app /var/www/html

# Bake the compiled frontend assets (public/build/) into the image.
COPY --from=frontend /app/public/build /var/www/html/public/build

# Bootstrap/cache and storage must be writable by www-data (the PHP-FPM user).
# Reasonable 775 layout — NOT a blanket 777 on the whole application.
RUN mkdir -p \
        /var/www/html/storage/framework/cache/data \
        /var/www/html/storage/framework/sessions \
        /var/www/html/storage/framework/views \
        /var/www/html/storage/logs \
        /var/www/html/storage/app/public \
        /var/www/html/bootstrap/cache \
    && chown -R www-data:www-data \
        /var/www/html/storage \
        /var/www/html/bootstrap/cache \
    && chmod -R 775 /var/www/html/storage /var/www/html/bootstrap/cache

# Recreate the public storage symlink (excluded from the build context as the
# host reparse point is not portable into the image).
RUN ln -s /var/www/html/storage/app/public /var/www/html/public/storage

# Nginx vhost template — rendered at container start with the Railway PORT
# (docker/railway-entrypoint.sh runs envsubst onto /etc/nginx/conf.d/).
COPY docker/nginx/railway-default.conf.template /etc/nginx/templates/default.conf.template

# Entrypoint: render Nginx config + Laravel optimisations, then exec the CMD.
# Shared by the web service (nginx+php-fpm) and the worker service (queue:work).
COPY docker/railway-entrypoint.sh /usr/local/bin/railway-entrypoint
RUN chmod +x /usr/local/bin/railway-entrypoint

ENTRYPOINT ["railway-entrypoint"]

# Web service default: start PHP-FPM as a daemon, then Nginx in the foreground
# so the container stays alive and serves HTTP on $PORT. The Railway worker
# service overrides CMD with `php artisan queue:work database --tries=3`.
CMD ["sh", "-c", "php-fpm -D && nginx -g 'daemon off;'"]